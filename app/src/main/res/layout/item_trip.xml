<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/card_background"
    android:padding="16dp"
    android:layout_marginBottom="10dp">

    <!-- Row 1: Date + Score -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvTripDate"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="12 Jul 2025, 10:30 AM"
            android:textColor="@color/colorText"
            android:textSize="14sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/tvTripScore"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Score: 85"
            android:textColor="@color/colorAccent"
            android:textSize="14sp"
            android:textStyle="bold"/>

    </LinearLayout>

    <!-- Row 2: Duration + Events + Distance -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="6dp">

        <TextView
            android:id="@+id/tvTripDuration"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="⏱ 12:35"
            android:textColor="@color/colorTextSecondary"
            android:textSize="12sp"/>

        <TextView
            android:id="@+id/tvTripEvents"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="⚠️ 3 events"
            android:textColor="@color/colorWarning"
            android:textSize="12sp"/>

        <TextView
            android:id="@+id/tvTripDistance"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="📍 4.2 km"
            android:textColor="@color/colorTextSecondary"
            android:textSize="12sp"/>

    </LinearLayout>

</LinearLayout>
